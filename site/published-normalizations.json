{
  "version": 1,
  "methods": {
    "compass": {
      "source": "https://github.com/EndeavourSyc/Hi-Compass/blob/main/hicompass/preprocess/hic_norm.py",
      "balance": false,
      "percentile_method": "band",
      "band_bp": 2500000,
      "percentiles": [
        2,
        99
      ],
      "target_scale": 100,
      "diagonals_zeroed": [
        0,
        1,
        -1
      ],
      "input_scope": "exported cis counts up to 4.1 Mb"
    },
    "evo2hic": {
      "commit": "633c92de6dd6422ad3b44143bf890a2067f45060",
      "source_files": [
        "dataset/normalizer.py",
        "dataset/data_arguments.py",
        "dataset/hic_dna_dataset.py"
      ],
      "target_option": "hic",
      "normalization": "mixed",
      "max_reads": 5000,
      "denominator": 10,
      "eps": 1e-05,
      "cap_max": 1
    },
    "hicfoundation": {
      "commit": "c733ffa6a3de071ba4b3bf6afca6bc9a0c741910",
      "source_files": [
        "data_processing/finetune_dataset.py",
        "data_processing/inference_dataset.py",
        "inference/main_worker.py"
      ],
      "representation": "encoder input intensity and standardized RGB",
      "normalization_scope": "full selected native viewer window",
      "rgb_mean": [
        0.485,
        0.456,
        0.406
      ],
      "rgb_std": [
        0.229,
        0.224,
        0.225
      ],
      "not_a_universal_task_target": true
    }
  }
}
